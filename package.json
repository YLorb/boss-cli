{
  "name": "@joohw/boss-cli",
  "version": "0.6.11",
  "description": "Boss直聘自动化 CLI：批量发消息、自动打招呼、候选人管理、深度搜索。基于 Puppeteer/CDP 驱动本机 Chrome，支持 AI Agent 编排",
  "keywords": [
    "boss",
    "boss-cli",
    "boss直聘",
    "boss-zhipin",
    "zhipin",
    "bosszp",
    "招聘自动化",
    "hr-automation",
    "recruitment-automation",
    "puppeteer",
    "cdp",
    "chrome-devtools-protocol",
    "cli",
    "agent",
    "ai-agent",
    "自动打招呼",
    "批量发消息",
    "候选人管理",
    "hr-tools",
    "boss-direct"
  ],
  "homepage": "https://boss-cli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joohw/boss-cli.git"
  },
  "bugs": {
    "url": "https://github.com/joohw/boss-cli/issues"
  },
  "type": "module",
  "main": "dist/cli/index.js",
  "types": "dist/cli/index.d.ts",
  "bin": {
    "boss": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "scripts/switch-job.mjs",
    "docs/boss-url-map.md",
    "docs/cli-json-output.md",
    "docs/collection-ledger.md",
    "docs/workbuddy-recruitment-runbook.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && node dist/cli/index.js",
    "test:check-dom": "node --test scripts/test-check-dom.mjs",
    "test:readonly-check": "node --experimental-test-module-mocks --test scripts/test-readonly-check.mjs",
    "test:json": "node --experimental-test-module-mocks --test scripts/test-cli-json.mjs",
    "test:paste": "node --experimental-test-module-mocks --test scripts/test-send-paste.mjs",
    "test:send-contenteditable": "node --experimental-test-module-mocks --test scripts/test-send-contenteditable.mjs",
    "test:check": "node --experimental-test-module-mocks --test scripts/test-conversation-check.mjs",
    "test:check-login": "node --experimental-test-module-mocks --test scripts/test-check-login.mjs",
    "test:collection": "node --test scripts/test-collection.mjs",
    "test:collection-page": "node --experimental-test-module-mocks --test scripts/test-collection-page.mjs",
    "test:baidu": "node --env-file=.env scripts/test-baidu-ocr.mjs",
    "deploy": "npm --prefix landing run deploy",
    "test:browser-entry": "node --experimental-test-module-mocks --test scripts/test-browser-entry.mjs",
    "test:resume-timing": "node --experimental-test-module-mocks --test scripts/test-resume-capture-timing.mjs scripts/test-resume-chat-close.mjs",
    "test:positions": "node --experimental-test-module-mocks --test scripts/test-positions.mjs",
    "test:switch-job": "node --experimental-test-module-mocks --test scripts/test-switch-job.mjs scripts/test-switch-job-route.mjs",
    "test:search-more-back": "node --experimental-test-module-mocks --test scripts/test-search-more-back.mjs",
    "test:resume-analysis": "node --test scripts/test-resume-analysis-session.mjs",
    "test:resume-ocr": "node --test scripts/test-resume-ocr.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.29.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.3.3"
  },
  "author": "Joo <1546635571@qq.com>",
  "license": "GPL-3.0"
}
